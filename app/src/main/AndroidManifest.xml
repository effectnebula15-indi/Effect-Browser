<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".EffectBrowserApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EffectBrowser"
        tools:targetApi="34">

        <!--
          Direct-connection browsing. Default process, GeckoRuntime with no proxy.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Tor browsing.

          The android:process attribute is the load-bearing part of this app's threat model, not
          an optimisation. Gecko's network.proxy.* preferences are per-process and a process may
          host only one GeckoRuntime, so a container can only be reliably pinned to tor by giving
          it a process whose runtime has never been configured for direct connections.

          Not exported: nothing outside the app may hand this activity a URL to load over tor.
        -->
        <activity
            android:name=".ui.TorBrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:process=":tor"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!--
          Lets other apps open a file the user downloaded on API 26-28, where the file lives in
          this app's own external directory rather than in MediaStore.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          kmp-tor declares TorService in its own manifest without a process. Merge :tor onto it so
          the daemon runs beside the runtime that consumes its SOCKS port; otherwise the port
          would be bound in the main process and would have to be shipped across an IPC boundary.
        -->
        <service
            android:name="io.matthewnelson.kmp.tor.runtime.service.TorService"
            android:process=":tor"
            tools:node="merge" />

    </application>

</manifest>
